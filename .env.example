# Email / SMTP — leave commented for Ethereal auto-preview in dev (the API
# prints a clickable preview URL to the logs on each send). To send real
# emails without a domain, use Gmail SMTP with an App Password:
#   1. Enable 2-Step Verification on the Google account.
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Uncomment below and fill in SMTP_USER / SMTP_PASS.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=your_gmail@gmail.com
#SMTP_PASS=your_16_char_app_password
#SMTP_FROM="Althea Shop <your_gmail@gmail.com>"
FRONTEND_URL=http://localhost:3000
